<% group = @db.group?(@conversation) %>
<% line = @db.lines[@conversation["line"]] || {} %>
<% service = @db.service_for(@conversation) %>
<header class="pp-head" data-service="<%= service %>">
  <a href="<%= root_path(list: 1) %>" class="pp-back" aria-label="Back">‹</a>
  <%= pp_avatar(group ? "👥" : pp_title(@conversation), key: @conversation["id"], size: 36) %>
  <div class="pp-head-title">
    <strong><%= pp_title(@conversation) %></strong>
    <span>
      <% if group %>
        <%= @conversation["participants"].map { |n| pp_person_name(n) }.join(", ") %>
      <% else %>
        <%= PocketPhone::Numbers.pretty(@conversation["number"]) %>
      <% end %>
      · texting <%= pp_line_name(@conversation["line"]) %>
      <% if line["name"].present? %>(<%= PocketPhone::Numbers.pretty(@conversation["line"]) %>)<% end %>
    </span>
  </div>

  <div class="pp-head-controls">
    <% if group %>
      <span class="pp-pill <%= service.downcase %>"><%= service == "iMessage" ? "iMessage group" : "Group MMS" %></span>
    <% else %>
      <% person = @db.people[@conversation["number"]] || {} %>
      <%= form_with url: people_path, method: :post, data: { remote: true } do %>
        <%= hidden_field_tag :number, @conversation["number"] %>
        <label>Phone
          <%= select_tag :service, options_for_select([["iPhone (iMessage)", "iMessage"], ["Android (SMS)", "SMS"], ["Android (RCS)", "RCS"]], person["service"]), data: { autosubmit: true } %>
        </label>
        <label>Sends to it
          <%= select_tag :outcome, options_for_select([["are delivered", "delivered"], ["fail after sending", "failed"], ["are refused", "rejected"]], person["outcome"]), data: { autosubmit: true } %>
        </label>
      <% end %>
    <% end %>
    <%= form_with url: delete_conversation_path(@conversation["id"]), method: :post, data: { confirm: "Delete this conversation?" } do %>
      <button type="submit" class="pp-icon" title="Delete conversation" aria-label="Delete conversation">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
      </button>
    <% end %>
  </div>
</header>
<% unless PocketPhone.config.webhook_url %>
  <div class="pp-banner">No <code>webhook_url</code> is configured, so texts from this phone will not reach your app.</div>
<% end %>
