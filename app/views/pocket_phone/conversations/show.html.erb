<% group = @conversation && @db.group?(@conversation) %>
<div class="pp <%= "pp-has-thread" if @conversation %>" data-pp
     data-base="<%= pp_base %>"
     data-conversation="<%= @conversation && @conversation["id"] %>"
     data-group="<%= group ? 1 : 0 %>">
  <aside class="pp-sidebar">
    <div class="pp-sidebar-top">
      <h1>Messages</h1>
      <button type="button" class="pp-icon" data-open-dialog title="New conversation" aria-label="New conversation">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      </button>
    </div>
    <div id="pp-sidebar"><%= render "pocket_phone/conversations/sidebar" %></div>
    <div class="pp-sidebar-foot">
      <%= form_with url: clear_path, method: :post, data: { confirm: "Clear every conversation?" } do %>
        <button type="submit" class="pp-link">Clear conversations</button>
      <% end %>
      <span>pocket_phone <%= PocketPhone::VERSION %></span>
    </div>
  </aside>

  <main class="pp-thread">
    <% if @conversation %>
      <div id="pp-head"><%= render "pocket_phone/conversations/head" %></div>
      <div id="pp-messages" class="pp-messages"><%= render "pocket_phone/conversations/messages" %></div>

      <%= form_with url: conversation_messages_path(@conversation["id"]), method: :post, multipart: true,
            class: "pp-compose", data: { compose: true } do %>
        <label class="pp-icon pp-attach" title="Attach a file">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          <input type="file" name="file" hidden>
        </label>
        <div class="pp-field">
          <% if group %>
            <select name="as" class="pp-as" data-persona title="Who is texting">
              <% @conversation["participants"].each do |number| %>
                <option value="<%= number %>"><%= pp_person_name(number) %></option>
              <% end %>
            </select>
          <% end %>
          <span class="pp-attached" data-attached hidden></span>
          <textarea name="content" rows="1" placeholder="<%= @db.service_for(@conversation) == "iMessage" ? "iMessage" : "Text Message" %>" autofocus></textarea>
          <button type="submit" class="pp-send" aria-label="Send">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          </button>
        </div>
      <% end %>
    <% else %>
      <div class="pp-empty">
        <div class="pp-empty-phone">📱</div>
        <% if @db.conversations.any? %>
          <h2>Pick a conversation</h2>
          <p>Or start a new one.</p>
        <% else %>
          <h2>No conversations yet</h2>
          <p>Messages your app sends through Sendblue will show up here. Or pick up the phone and text it first.</p>
        <% end %>
        <button type="button" class="pp-button" data-open-dialog>New conversation</button>
        <% unless PocketPhone.config.webhook_url %>
          <p class="pp-hint">No <code>webhook_url</code> is configured, so texts from this phone will not reach your app. See the README.</p>
        <% end %>
      </div>
    <% end %>
  </main>

  <%= render "pocket_phone/conversations/new_dialog" %>
</div>
