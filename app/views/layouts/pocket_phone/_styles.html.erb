<style>
  :root {
    --bg: #ffffff; --side: #f4f4f6; --line: #e2e2e7; --text: #111113; --muted: #86868b;
    --grey: #e9e9eb; --grey-text: #111113; --blue: #0b84fe; --green: #34c759; --red: #ff3b30;
    --select: #0a6fe0; --card: #f1f1f3; --field: #ffffff; --shadow: 0 8px 40px rgba(0, 0, 0, .18);
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1c1e; --side: #232326; --line: #38383c; --text: #f5f5f7; --muted: #98989f;
      --grey: #3a3a3d; --grey-text: #f5f5f7; --blue: #0b84fe; --green: #30d158; --red: #ff453a;
      --select: #0a6fe0; --card: #2c2c2f; --field: #1c1c1e; --shadow: 0 8px 40px rgba(0, 0, 0, .6);
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    background: var(--bg); color: var(--text);
    font: 15px/1.35 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  button, input, select, textarea { font: inherit; color: inherit; }
  code, pre { font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  [hidden] { display: none !important; }

  .pp { display: grid; grid-template-columns: 320px minmax(0, 1fr); height: 100dvh; }

  /* --- sidebar ------------------------------------------------------------ */
  .pp-sidebar { display: flex; flex-direction: column; min-height: 0; background: var(--side); border-right: 1px solid var(--line); }
  .pp-sidebar-top { display: flex; align-items: center; justify-content: space-between; padding: 16px 12px 10px 18px; }
  .pp-sidebar-top h1 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -.01em; }
  #pp-sidebar { flex: 1; overflow-y: auto; padding: 0 8px; }
  .pp-sidebar-empty { color: var(--muted); padding: 8px 12px; margin: 0; }
  .pp-sidebar-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .pp-sidebar-foot form { margin: 0; }

  .pp-item { display: flex; align-items: center; gap: 10px; padding: 10px 10px 10px 4px; border-radius: 10px; color: inherit; text-decoration: none; }
  .pp-item:hover { background: color-mix(in srgb, var(--text) 6%, transparent); }
  .pp-item.current { background: var(--select); color: #fff; }
  .pp-item-body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .pp-item-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .pp-item-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pp-item-time { font-size: 12px; color: var(--muted); flex: none; }
  .pp-item-snippet { font-size: 13px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; min-height: 1.35em; }
  .pp-item.current .pp-item-time, .pp-item.current .pp-item-snippet { color: rgba(255, 255, 255, .8); }
  .pp-unread { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .pp-unread.on { background: var(--blue); }

  .pp-avatar { display: inline-grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; overflow: hidden; color: #fff; font-size: 16px; font-weight: 600; background: linear-gradient(hsl(var(--hue, 220) 28% 68%), hsl(var(--hue, 220) 28% 50%)); }
  .pp-avatar img { width: 100%; height: 100%; object-fit: cover; }

  /* --- thread ------------------------------------------------------------- */
  .pp-thread { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .pp-head { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
  .pp-back { display: none; font-size: 30px; line-height: 1; color: var(--blue); text-decoration: none; padding: 0 6px 4px 0; }
  .pp-head-title { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .pp-head-title span { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pp-head-controls { display: flex; align-items: center; gap: 10px; flex: none; }
  .pp-head-controls form { display: flex; align-items: center; gap: 10px; margin: 0; }
  .pp-head-controls label { display: flex; flex-direction: column; gap: 2px; font-size: 11px; color: var(--muted); }
  .pp-head-controls select { font-size: 13px; padding: 3px 6px; border-radius: 7px; border: 1px solid var(--line); background: var(--field); }
  .pp-pill { font-size: 12px; padding: 3px 10px; border-radius: 999px; color: #fff; background: var(--green); }
  .pp-pill.imessage { background: var(--blue); }
  .pp-banner { padding: 8px 16px; font-size: 13px; background: color-mix(in srgb, #ffcc00 22%, var(--bg)); border-bottom: 1px solid var(--line); }

  .pp-messages { flex: 1; overflow-y: auto; padding: 12px 16px 6px; display: flex; flex-direction: column; }
  .pp-stamp { margin: 14px 0 6px; text-align: center; font-size: 12px; color: var(--muted); }
  .pp-stamp strong { font-weight: 600; }

  .pp-row { display: flex; flex-direction: column; align-items: flex-start; margin-top: 8px; }
  .pp-row.continued { margin-top: 2px; }
  .pp-row.mine { align-items: flex-end; }
  .pp-sender { font-size: 12px; color: var(--muted); margin: 4px 0 2px 12px; }
  .pp-row.mine .pp-sender { display: none; }
  .pp-line { display: flex; align-items: center; gap: 6px; max-width: min(78%, 560px); }
  .pp-row.mine .pp-line { flex-direction: row-reverse; }
  .pp-stack { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 3px; min-width: 0; }
  .pp-row.mine .pp-stack { align-items: flex-end; }

  .pp-bubble { padding: 7px 12px; border-radius: 18px; background: var(--grey); color: var(--grey-text); white-space: pre-wrap; overflow-wrap: anywhere; }
  .pp-bubble a { color: inherit; }
  .pp-row.mine .pp-bubble { background: var(--green); color: #fff; }
  .pp-row.mine.imessage .pp-bubble { background: var(--blue); }
  .pp-row.undelivered .pp-stack { opacity: .45; }

  .pp-media { display: block; max-width: 280px; max-height: 320px; border-radius: 16px; }
  .pp-audio { max-width: 280px; }
  .pp-file { display: inline-block; padding: 8px 12px; border-radius: 14px; background: var(--card); color: inherit; text-decoration: none; }
  .pp-carousel { display: flex; gap: 6px; max-width: 100%; overflow-x: auto; scroll-snap-type: x mandatory; }
  .pp-carousel > * { flex: none; scroll-snap-align: start; }
  .pp-carousel .pp-media { max-width: 200px; max-height: 240px; }

  .pp-card { display: block; width: 280px; max-width: 100%; border-radius: 16px; overflow: hidden; background: var(--card); color: inherit; text-decoration: none; }
  .pp-card-image { position: relative; }
  .pp-card-image img { display: block; width: 100%; max-height: 220px; object-fit: cover; }
  .pp-card-overlay { position: absolute; inset: auto 0 0 0; padding: 18px 12px 8px; color: #fff; background: linear-gradient(transparent, rgba(0, 0, 0, .6)); display: flex; flex-direction: column; }
  .pp-card-body { display: flex; flex-direction: column; gap: 1px; padding: 8px 12px 9px; }
  .pp-card-body strong { font-size: 14px; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pp-card-body span { font-size: 12px; color: var(--muted); }
  .pp-card-split { flex-direction: row; justify-content: space-between; gap: 12px; }
  .pp-card-split div { display: flex; flex-direction: column; }
  .pp-card-split .trailing { text-align: right; }
  .pp-card-app, .pp-card-warning { padding: 6px 12px 8px; font-size: 11px; color: var(--muted); border-top: 1px solid var(--line); }
  .pp-card-warning { color: #b25000; background: color-mix(in srgb, #ffcc00 18%, var(--card)); }

  .pp-reactions { position: absolute; top: -12px; right: -10px; display: flex; gap: 2px; padding: 2px 5px; border-radius: 999px; background: var(--card); border: 2px solid var(--bg); font-size: 12px; line-height: 1.2; }
  .pp-row.mine .pp-reactions { right: auto; left: -10px; }
  .pp-row:has(.pp-reactions) { margin-top: 18px; }

  .pp-tools { display: flex; align-items: center; gap: 4px; flex: none; opacity: 0; transition: opacity .12s; }
  .pp-row:hover .pp-tools, .pp-row.open .pp-tools { opacity: 1; }
  .pp-tapbacks { display: flex; padding: 2px 4px; border-radius: 999px; background: var(--card); }
  .pp-tapbacks button { border: 0; background: none; padding: 2px 3px; cursor: pointer; font-size: 14px; border-radius: 50%; }
  .pp-tapbacks button:hover { transform: scale(1.25); }
  .pp-info { border: 0; background: none; padding: 2px 4px; cursor: pointer; color: var(--muted); font-size: 15px; }

  .pp-receipt, .pp-note { font-size: 11px; color: var(--muted); margin: 2px 6px 0; max-width: min(78%, 560px); }
  .pp-receipt { font-weight: 600; }
  .pp-receipt span { font-weight: 400; }
  .pp-receipt.failed { color: var(--red); }

  .pp-details { align-self: stretch; margin: 6px 0 4px; padding: 10px 12px; border-radius: 12px; background: var(--card); font-size: 12px; overflow-x: auto; }
  .pp-details dl { display: grid; grid-template-columns: max-content 1fr; gap: 3px 12px; margin: 0; }
  .pp-details dt { color: var(--muted); }
  .pp-details dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .pp-details ul { margin: 0 0 4px; padding: 0; list-style: none; }
  .pp-details li span { color: var(--muted); }
  .pp-details li.bad b, .pp-details li.bad { color: var(--red); }
  .pp-details pre { margin: 8px 0 0; padding-top: 8px; border-top: 1px solid var(--line); white-space: pre-wrap; overflow-wrap: anywhere; }

  .pp-typing { display: inline-flex; gap: 4px; padding: 11px 12px; }
  .pp-typing i { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); animation: pp-blink 1.2s infinite both; }
  .pp-typing i:nth-child(2) { animation-delay: .2s; }
  .pp-typing i:nth-child(3) { animation-delay: .4s; }
  @keyframes pp-blink { 0%, 60%, 100% { opacity: .35; } 30% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .pp-typing i { animation: none; } }

  /* --- compose ------------------------------------------------------------ */
  .pp-compose { display: flex; align-items: flex-end; gap: 8px; padding: 8px 16px 14px; margin: 0; }
  .pp-field { flex: 1; display: flex; align-items: flex-end; gap: 6px; min-width: 0; padding: 4px 4px 4px 12px; border: 1px solid var(--line); border-radius: 20px; background: var(--field); }
  .pp-field textarea { flex: 1; min-width: 0; border: 0; outline: 0; resize: none; background: none; padding: 4px 0; max-height: 140px; }
  .pp-as { border: 0; background: var(--card); border-radius: 999px; padding: 4px 8px; font-size: 12px; margin-bottom: 1px; max-width: 130px; }
  .pp-attached { font-size: 12px; padding: 4px 8px; border-radius: 999px; background: var(--card); white-space: nowrap; max-width: 160px; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
  .pp-send { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border: 0; border-radius: 50%; background: var(--blue); color: #fff; cursor: pointer; }
  .pp-compose.sms .pp-send { background: var(--green); }
  .pp-icon { display: inline-grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 50%; background: none; color: var(--blue); cursor: pointer; }
  .pp-icon:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
  .pp-attach { color: var(--muted); background: var(--card); margin-bottom: 2px; }

  .pp-link { border: 0; background: none; padding: 0; color: var(--blue); cursor: pointer; font-size: inherit; }
  .pp-button { border: 0; border-radius: 999px; padding: 8px 18px; background: var(--blue); color: #fff; font-weight: 600; cursor: pointer; }
  .pp-hint { color: var(--muted); font-size: 13px; }

  .pp-empty { margin: auto; max-width: 380px; padding: 24px; text-align: center; }
  .pp-empty-phone { font-size: 56px; }
  .pp-empty h2 { margin: 8px 0 6px; }
  .pp-empty p { color: var(--muted); margin: 0 0 16px; }
  .pp-empty .pp-hint { margin-top: 18px; }

  /* --- new conversation --------------------------------------------------- */
  .pp-dialog { width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); padding: 18px 20px 20px; border: 0; border-radius: 16px; background: var(--bg); color: var(--text); box-shadow: var(--shadow); }
  .pp-dialog::backdrop { background: rgba(0, 0, 0, .35); }
  .pp-dialog-top { display: flex; align-items: center; justify-content: space-between; }
  .pp-dialog h2 { margin: 0; font-size: 18px; }
  .pp-dialog h3 { margin: 18px 0 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .pp-people { display: flex; flex-direction: column; gap: 2px; }
  .pp-people form { margin: 0; }
  .pp-person { display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 8px; border: 0; border-radius: 10px; background: none; text-align: left; cursor: pointer; }
  .pp-person:hover { background: var(--card); }
  .pp-person span:last-child { display: flex; flex-direction: column; }
  .pp-person small { color: var(--muted); }
  .pp-form { display: flex; flex-direction: column; gap: 10px; margin: 0; }
  .pp-form > label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); }
  .pp-form input[type="text"], .pp-form select { padding: 7px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--field); color: var(--text); }
  .pp-form .pp-button { align-self: flex-start; }
  .pp-checks { display: flex; flex-wrap: wrap; gap: 6px 16px; }

  @media (max-width: 720px) {
    .pp { grid-template-columns: minmax(0, 1fr); }
    .pp.pp-has-thread .pp-sidebar, .pp:not(.pp-has-thread) .pp-thread { display: none; }
    .pp:not(.pp-has-thread) .pp-sidebar { border-right: 0; }
    .pp-back { display: block; }
    .pp-head { flex-wrap: wrap; padding: 8px 12px; }
    .pp-head-controls { width: 100%; justify-content: flex-end; }
    .pp-messages { padding: 12px 12px 6px; }
    .pp-compose { padding: 8px 12px 12px; }
    .pp-line { max-width: 88%; }
    .pp-tools { opacity: 1; }
    .pp-tapbacks { display: none; }
    .pp-row.open .pp-tapbacks { display: flex; }
  }
</style>
